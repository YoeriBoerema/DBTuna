{
  "name": "dbtuna",
  "displayName": "DBTuna",
  "description": "Inspect PostgreSQL, SQL Server and Oracle execution plans beside your SQL.",
  "version": "0.8.0",
  "publisher": "dbtuna-local",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "postgresql",
    "explain",
    "sql",
    "sqlserver",
    "oracle"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:dbtuna.databaseExplorer",
    "onCommand:dbtuna.doom"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "test:postgres": "tsx --test test/integration/postgres.test.ts",
    "test:vscode": "node test/vscode/run.cjs",
    "package": "node scripts/package.mjs",
    "lint": "eslint src packages webview test scripts *.mjs",
    "verify": "node test/verify.mjs",
    "test:browser": "node test/browser.mjs",
    "screenshots": "node test/browser.mjs --update-screenshots",
    "test:postgres:docker": "node test/integration/postgres-docker.mjs",
    "format": "prettier --write src packages webview test scripts *.json *.mjs",
    "format:check": "prettier --check src packages webview test scripts *.json *.mjs",
    "docs:versions": "node scripts/sync-build-info.mjs",
    "test:oracle": "tsx --test test/integration/oracle.test.ts",
    "test:oracle:docker": "node test/integration/oracle-docker.mjs",
    "test:sqlserver": "tsx --test test/integration/sqlserver.test.ts",
    "test:sqlserver:docker": "node test/integration/sqlserver-docker.mjs",
    "test:databases": "node test/integration/databases.mjs"
  },
  "contributes": {
    "configuration": {
      "title": "DBTuna",
      "properties": {
        "dbtuna.alwaysShowDatabaseExplorer": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "title": "Always Show Database Explorer",
          "description": "Reveal the Database Explorer when VS Code starts. Enabling this setting also reveals it immediately."
        }
      }
    },
    "commands": [
      {
        "command": "dbtuna.showExplorer",
        "title": "DBTuna: Show Database Explorer",
        "icon": "$(database)"
      },
      {
        "command": "dbtuna.visualizeRelationships",
        "title": "DBTuna: Visualize Table Relationships",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbtuna.explainQuery",
        "title": "DBTuna: Explain Query",
        "icon": "$(graph)"
      },
      {
        "command": "dbtuna.importPlan",
        "title": "DBTuna: Import Execution Plan"
      },
      {
        "command": "dbtuna.exportPlan",
        "title": "DBTuna: Export Execution Plan"
      },
      {
        "command": "dbtuna.addConnection",
        "title": "DBTuna: Add Connection"
      },
      {
        "command": "dbtuna.selectConnection",
        "title": "DBTuna: Select Connection"
      },
      {
        "command": "dbtuna.manageConnections",
        "title": "DBTuna: Manage Connections"
      },
      {
        "command": "dbtuna.loadSamplePlan",
        "title": "DBTuna: Load Sample Plan"
      },
      {
        "command": "dbtuna.aiAssistance",
        "title": "DBTuna: AI Assistance"
      },
      {
        "command": "dbtuna.aiSetApiKey",
        "title": "DBTuna: AI Assistance: Set API Key"
      },
      {
        "command": "dbtuna.aiSelectModel",
        "title": "DBTuna: AI Assistance: Select Model"
      },
      {
        "command": "dbtuna.aiRemoveApiKey",
        "title": "DBTuna: AI Assistance: Remove API Key"
      },
      {
        "command": "dbtuna.refreshExplorer",
        "title": "DBTuna: Refresh Database Explorer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dbtuna.explainQuery",
          "when": "editorLangId =~ /^(sql|pgsql|postgres|postgresql)$/ || resourceExtname == .sql",
          "group": "navigation"
        },
        {
          "submenu": "dbtuna.aiMenu",
          "group": "navigation",
          "when": "editorLangId =~ /^(sql|pgsql|postgres|postgresql)$/ || resourceExtname == .sql"
        }
      ],
      "editor/title": [
        {
          "command": "dbtuna.explainQuery",
          "when": "editorLangId =~ /^(sql|pgsql|postgres|postgresql)$/ || resourceExtname == .sql",
          "group": "navigation"
        }
      ],
      "dbtuna.aiMenu": [
        {
          "command": "dbtuna.aiSetApiKey",
          "group": "1_settings"
        },
        {
          "command": "dbtuna.aiSelectModel",
          "group": "1_settings"
        },
        {
          "command": "dbtuna.aiRemoveApiKey",
          "group": "1_settings"
        }
      ],
      "view/title": [
        {
          "command": "dbtuna.refreshExplorer",
          "when": "view == dbtuna.databaseExplorer",
          "group": "navigation"
        },
        {
          "command": "dbtuna.addConnection",
          "when": "view == dbtuna.databaseExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbtuna.visualizeRelationships",
          "when": "view == dbtuna.databaseExplorer && viewItem == dbtuna.database",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "dbtuna.visualizeRelationships",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "dbtuna.aiMenu",
        "label": "DBTuna: AI Assistance"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "dbtuna.databaseExplorer",
          "name": "DBTuna Database Explorer",
          "contextualTitle": "DBTuna"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbtuna.databaseExplorer",
        "contents": "Browse schemas, tables, columns, keys and indexes. Only objects visible to your database account are shown. Use Refresh to reload metadata."
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Offline plans are available; live connections require trust."
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "elkjs": "^0.11.0",
    "fast-xml-parser": "^5.11.2",
    "oracledb": "6.10.0",
    "pg": "^8.16.0",
    "pgsql-ast-parser": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tedious": "^18.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "yauzl": "^3.4.0"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoeriBoerema/DBTuna.git"
  },
  "bugs": {
    "url": "https://github.com/YoeriBoerema/DBTuna/issues"
  },
  "homepage": "https://github.com/YoeriBoerema/DBTuna#readme"
}
